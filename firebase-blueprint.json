{
  "entities": {
    "Product": {
      "title": "Product",
      "description": "Electronic product available in the store",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "description": { "type": "string" },
        "price": { "type": "number" },
        "category": { "type": "string" },
        "image": { "type": "string" },
        "brand": { "type": "string" },
        "specifications": { "type": "object" },
        "inStock": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["name", "category", "price"]
    },
    "Category": {
      "title": "Category",
      "description": "Product category",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "icon": { "type": "string" }
      },
      "required": ["name"]
    },
    "BusinessInfo": {
      "title": "Business Info",
      "description": "General business information",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "email": { "type": "string" },
        "phone": { "type": "array", "items": { "type": "string" } },
        "address": { "type": "array", "items": { "type": "string" } },
        "hours": { "type": "object" },
        "whatsapp": { "type": "string" },
        "whatsappTemplate": { "type": "string" }
      }
    }
  },
  "firestore": {
    "products": {
      "schema": "Product",
      "description": "Collection of all products"
    },
    "categories": {
      "schema": "Category",
      "description": "Product categories"
    },
    "settings": {
      "schema": "BusinessInfo",
      "description": "Store settings and business info"
    }
  }
}
